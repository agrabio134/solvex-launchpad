# ---------- Network ----------
# Solana RPC used by the server-side proxy /api/rpc (keeps the key private).
# Needs getProgramAccounts support: Helius / Triton / QuickNode. Public RPCs block it.
RPC_URL=https://mainnet.helius-rpc.com/?api-key=YOUR_KEY
# Optional: point the browser straight at an RPC instead of the proxy (exposes the URL)
VITE_RPC_URL=
VITE_CLUSTER=mainnet-beta          # mainnet-beta | devnet (used for explorer links)

# ---------- $SVX ----------
VITE_SVX_MINT=                     # $SVX mint (optional: pre-fills /admin and the header before the config exists)
# (decimals are read from the chain)

# ---------- Meteora DBC ----------
# Config key created at /admin (or `npm run create-config -- --send`).
# Holds the curve, fees and graduation threshold. Its quote mint is $SVX.
VITE_DBC_CONFIG=

# ---------- Socials ----------
VITE_X_URL=https://x.com/solvex
VITE_TG_URL=

# ---------- Server only (Vercel env) ----------
# Vercel Blob token for image + metadata uploads (api/upload.ts).
# Injected automatically when a Blob store is connected to the project.
BLOB_READ_WRITE_TOKEN=

# ---------- Scripts only ----------
# Path to the partner keypair JSON that owns the config & receives partner fees
PARTNER_KEYPAIR=./partner-keypair.json
