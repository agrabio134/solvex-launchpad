# ---------- Required ----------
# $FLIP mint: the quote currency of every Solvex market
VITE_FLIP_MINT=

# Platform wallet: fee partner on every launch (receives 50% of trading fees + half the locked LP)
VITE_PLATFORM_WALLET=C1rdVXhfUe3RDNxMFrGYSHN6MpkhjTLhVaBk3ZpMJWnT

# Server-side Solana mainnet RPC used by /api/rpc (key stays private). Helius / Triton / QuickNode.
RPC_URL=https://mainnet.helius-rpc.com/?api-key=YOUR_KEY

# ---------- Launch sizing ----------
# Opening / graduation market caps in USD (converted to $FLIP at launch via GeckoTerminal)
VITE_OPEN_MCAP_USD=4000
VITE_GRAD_MCAP_USD=35000
# Fallback caps in $FLIP if $FLIP has no USD price yet (both required to enable)
VITE_OPEN_MCAP_FLIP=
VITE_GRAD_MCAP_FLIP=

# Only show markets launched after this unix time (hides pools from older launchpads on the same wallet)
VITE_LISTED_AFTER=1795616000

# ---------- Socials ----------
VITE_X_URL=https://x.com/solvex
VITE_TG_URL=

# ---------- Storage ----------
# Injected automatically when a Vercel Blob store is connected
BLOB_READ_WRITE_TOKEN=
